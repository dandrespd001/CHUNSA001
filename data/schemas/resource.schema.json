{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chunsa/resource.schema.json",
  "title": "resource v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "display_name_key", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "common.schema.json#/$defs/record_id"},
    "display_name_key": {"$ref": "common.schema.json#/$defs/localization_key"},
    "index": {"type": "integer", "minimum": 0, "maximum": 31, "readOnly": true},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"}
  }
}
